# ───── ENVIRONMENT ─────
# 'development' or 'production'
ENV=development

# ───── SHARED DATABASE ─────
DB_USER=admin_user
DB_PASS=secure_pass_2245
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dv-dashboard
DB_SSL=False

# ───── DISCORD AUTHENTICATION ─────
# You need these to implement the OAuth2 login for your panel
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The redirect URI you set in the Discord Developer Portal
DISCORD_REDIRECT_URI=

# ───── BOT SPECIFIC ─────
DISCORD_TOKEN=
PREFIX=ts
SYNC_COMMANDS=true

# ───── WEB PANEL SPECIFIC ─────
# Secret key to sign session cookies/JWTs
SECRET_KEY=a_very_secure_random_string_here
ALLOWED_ORIGINS=http://localhost:5173
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard