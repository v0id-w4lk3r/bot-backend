# ───── ENVIRONMENT ─────
# Options: 'development' or 'production'
ENV=development

# ───── POSTGRES DATABASE ─────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dv-dashboard
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_ECHO=False
DB_CREATE_TABLES=True
DB_CONNECT_TIMEOUT=5.0

# ───── REDIS CACHE & PUB/SUB ─────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ───── DISCORD OAUTH2 & BOT ─────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_REDIRECT_URI=http://localhost:8000/api/discord/callback
DISCORD_OAUTH_SCOPES=identify guilds

# ───── SECURITY & SESSIONS ─────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_string
ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=bot_panel_session
OAUTH_STATE_COOKIE_NAME=discord_oauth_state
SESSION_MAX_AGE_SECONDS=604800
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard
AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/login?error=auth_failed

# ───── BOT SPECIFIC (IF SHARING .ENV WITH BOT PROCESS) ─────
PREFIX=ts
SYNC_COMMANDS=true